# === PostgreSQL ===
# Реальные логин/пароль никогда не коммитить в Git.
DATABASE_URL=postgresql://user:password@localhost:5432/salary_db

# auto: TLS определяется по sslmode в DATABASE_URL и известным облачным хостам.
# Для нового внешнего PostgreSQL рекомендуется DB_SSL=true или ?sslmode=require в DATABASE_URL.
DB_SSL=auto
DB_SSL_REJECT_UNAUTHORIZED=false

# true разрешать только для доверенной приватной сети, где TLS сознательно не используется.
DB_ALLOW_PLAINTEXT=false

# === Application ===
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret

# Публичный адрес после переноса, например https://salary.example.ru
PUBLIC_URL=
APP_ORIGIN=
ALLOWED_ORIGINS=

# === Email verification ===
EMAIL_VERIFY_ENABLED=true

# === SMTP ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_CONNECTION_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=30000

# === Security backup / restore ===
# Каталог локальных backup-файлов. Он исключён из Git.
BACKUP_DIR=secure-backups

# Необязательные пути, если PostgreSQL client tools установлены не в PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# ТОЛЬКО отдельная тестовая БД для проверки восстановления.
# Никогда не указывать production DATABASE_URL.
RESTORE_DATABASE_URL=

# Явное подтверждение того, что RESTORE_DATABASE_URL — одноразовая тестовая БД.
CONFIRM_TEST_RESTORE=no
