# === PostgreSQL ===
# Реальные логин/пароль никогда не коммитить в Git.
DATABASE_URL=postgresql://user:password@localhost:5432/salary_db

# auto: TLS определяется по sslmode в DATABASE_URL и известным облачным хостам.
# Для нового внешнего PostgreSQL рекомендуется DB_SSL=true или ?sslmode=require в DATABASE_URL.
DB_SSL=auto
DB_SSL_REJECT_UNAUTHORIZED=false

# true разрешать только для доверенной приватной сети, где TLS сознательно не используется.
DB_ALLOW_PLAINTEXT=false

# === Application ===
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret

# Публичный адрес после переноса, например https://salary.example.ru
PUBLIC_URL=
APP_ORIGIN=
ALLOWED_ORIGINS=

# Новая регистрация только по приглашению организации.
REGISTRATION_INVITE_REQUIRED=true

# === Email verification ===
EMAIL_VERIFY_ENABLED=true

# === SMTP ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_CONNECTION_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=30000

# === Security backup / restore ===
# Каталог локальных backup-файлов. Он исключён из Git.
BACKUP_DIR=secure-backups

# Необязательные пути, если PostgreSQL client tools установлены не в PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# ТОЛЬКО отдельная тестовая БД для проверки восстановления.
# Никогда не указывать production DATABASE_URL.
RESTORE_DATABASE_URL=

# Явное подтверждение того, что RESTORE_DATABASE_URL — одноразовая тестовая БД.
CONFIRM_TEST_RESTORE=no

# === 152-FZ / legal / compliance ===
# Фактический регион production-контура с персональными данными.
DATA_REGION=RU

# Реквизиты оператора для публичной Политики, согласия и footer.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRNIP=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=

# Утверждённые эксплуатационные сроки. Перед production подтвердить их внутренним актом/политикой.
RETENTION_SECURITY_LOG_DAYS=365
RETENTION_BACKUP_DAYS=30
RETENTION_CONSENT_EVIDENCE_DAYS=1095
RETENTION_DSAR_EVIDENCE_DAYS=1095

# Production-readiness attestations. Значение true ставится только после фактического выполнения действия.
INFRA_RU_CONFIRMED=false
RKN_OPERATOR_NOTIFICATION_CONFIRMED=false
DPA_APPROVED=false
THREAT_MODEL_APPROVED=false
INCIDENT_RUNBOOK_APPROVED=false
BACKUP_RESTORE_VERIFIED=false

# MFA для технического ADMIN и роли "Руководитель сайта".
# Включать только после настройки SMTP и e-mail второго фактора.
PLATFORM_MFA_ENABLED=false
PLATFORM_ADMIN_MFA_EMAIL=

# Только для первичного создания ADMIN. После создания аккаунта удалить из окружения.
INITIAL_ADMIN_PASSWORD=

# === Cross-tenant acceptance test ===
# Только синтетические тестовые аккаунты в изолированной test/staging среде.
TEST_BASE_URL=
TEST_TENANT_A_LOGIN=
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_LOGIN=
TEST_TENANT_B_PASSWORD=

# Блокировать регистрацию новых пользователей, пока не заполнены реквизиты оператора.
COMPLIANCE_ENFORCE_LEGAL_READY=true

# После заполнения legal-реквизитов включите, чтобы legacy users не работали без актуального consent evidence.
COMPLIANCE_ENFORCE_CURRENT_CONSENTS=false
